		<properties>
			<!--
				Must be the Extended dialect, matching sormas-backend/src/main/resources/META-INF/persistence.xml.
				It registers function templates the entity model calls by name — at_end_of_day,
				unaccent, ilike, array_to_string, window_first_value_desc, fulltext_search,
				empty_to_null and others. With the plain PostgreSQL94Dialect Hibernate passes those
				names through as literal SQL function calls and PostgreSQL rejects them, e.g.
				"function at_end_of_day(unknown) does not exist" when saving a Vaccination.
			-->
			<property name="hibernate.dialect" value="de.symeda.sormas.backend.ExtendedPostgreSQL94Dialect"/>
			<property name="hibernate.criteria.literal_handling_mode" value="bind"/>
			<property name="hibernate.transaction.jta.platform"
					  value="org.hibernate.service.jta.platform.internal.SunOneJtaPlatform"/>
			<!--
				TC_INITFUNCTION applies versioning_function.sql and sormas_schema.sql once per
				container, so the schema is the migrated one rather than an hbm2ddl-generated
				approximation. See SormasPostgresSchemaInitializer for why that matters.
				The user is sormas_user because sormas_schema.sql assigns table ownership to it.
			-->
			<property name="javax.persistence.jdbc.driver" value="org.testcontainers.jdbc.ContainerDatabaseDriver"/>
			<property name="javax.persistence.jdbc.url"
					  value="jdbc:tc:postgresql:10.18-alpine:///sormas?TC_DAEMON=true&amp;TC_INITFUNCTION=de.symeda.sormas.backend.SormasPostgresSchemaInitializer::initialize"/>
			<property name="javax.persistence.jdbc.user" value="sormas_user"/>
			<property name="javax.persistence.jdbc.password" value="sormas_user"/>
			<!-- the schema comes from the migration scripts; Hibernate must not touch it -->
			<property name="hibernate.hbm2ddl.auto" value="none"/>

			<property name="hibernate.show_sql" value="false"/>
			<property name="hibernate.format_sql" value="false"/>

			<property name="hibernate.cache.use_second_level_cache" value="true"/>
			<property name="hibernate.cache.region.factory_class" value="org.hibernate.cache.ehcache.internal.SingletonEhcacheRegionFactory"/>

			<property name="hibernate.enable_lazy_load_no_trans" value="true"/>
		</properties>
	</persistence-unit>

</persistence>
