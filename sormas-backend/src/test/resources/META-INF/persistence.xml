	<!--
		PostgreSQL variant of beanTestPU, used by tests that exercise the native SQL the
		EpiPulse export relies on (DISTINCT ON, the ~ regex operator, STRING_AGG ... ORDER BY,
		FILTER, = ANY(array)), none of which H2 can run.

		The jdbc:tc: URL is Testcontainers' own driver: it starts a PostgreSQL container on
		first connection, so the URL can stay static here and no test code needs to know the
		port. Select it with -Dsormas.test.pu=beanTestPgPU.
	-->
	<persistence-unit name="beanTestPgPU" transaction-type="RESOURCE_LOCAL">

